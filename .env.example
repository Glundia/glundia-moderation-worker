# GCP Configuration
GCP_PROJECT=glundia-dev
ENVIRONMENT=dev

# Pub/Sub
PUBSUB_SUBSCRIPTION=moderation-worker-sub

# Storage Buckets
QUARANTINE_BUCKET=glundia-dev-uploads-quarantine
PUBLIC_BUCKET=glundia-dev-images-public
PRIVATE_BUCKET=glundia-dev-images-private
REJECTED_BUCKET=glundia-dev-images-rejected

# Database (use local PostgreSQL for development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/glundia

# Moderation
VISION_API_THRESHOLD=0.7
